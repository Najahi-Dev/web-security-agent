# ==============================================================
# Web Security Agent - Environment Configuration Template
# ==============================================================
# IMPORTANT: DO NOT commit real secrets or API keys to git.
# Copy this file to .env and configure your personal credentials:
#   cp .env.example .env

# Preferred LLM Provider: 'gemini' (default) or 'anthropic'
LLM_PROVIDER=gemini

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (https://console.anthropic.com/)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
